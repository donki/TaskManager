<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:TaskManager.Mobile.Localization"
             xmlns:pages="clr-namespace:TaskManager.Mobile.Pages"
             x:Class="TaskManager.Mobile.Pages.GroupsPage"
             Title="{loc:T MenuGroups}">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="ic_add_w.png" Clicked="OnNewGroupClicked" />
        <ToolbarItem IconImageSource="ic_key_w.png" Clicked="OnJoinGroupClicked" />
    </ContentPage.ToolbarItems>

    <CollectionView x:Name="GroupsView" SelectionMode="None" Margin="8">

        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="24" Spacing="8">
                <Label Text="{loc:T GroupsEmptyTitle}" Style="{StaticResource CardTitle}"
                       HorizontalTextAlignment="Center" />
                <Label Text="{loc:T GroupsEmptyMessage}"
                       Style="{StaticResource HintText}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="pages:GroupRow">
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <VerticalStackLayout Padding="12,10" Spacing="8">

                        <Grid ColumnDefinitions="40,*,Auto,Auto" ColumnSpacing="8">
                            <Image Grid.Column="0" Source="ic_group.png" WidthRequest="24" HeightRequest="24"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                <Label Text="{Binding Caption}" Style="{StaticResource ItemSubtitle}" />
                            </VerticalStackLayout>

                            <ImageButton Grid.Column="2" Style="{StaticResource RowIconButton}"
                                         Source="ic_add.png"
                                         CommandParameter="{Binding Id}"
                                         Clicked="OnNewListClicked" />
                            <ImageButton Grid.Column="3" Style="{StaticResource RowIconButton}"
                                         Source="ic_delete_danger.png"
                                         CommandParameter="{Binding Id}"
                                         Clicked="OnDeleteGroupClicked" />
                        </Grid>

                        <!-- Listas del grupo: un mismo grupo tiene varias (especificacion 2.A) -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lists}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="pages:ListRow">
                                    <Grid ColumnDefinitions="32,*" ColumnSpacing="8" Padding="8,6" Margin="32,0,0,0">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnListTapped" CommandParameter="{Binding Id}" />
                                        </Grid.GestureRecognizers>
                                        <Image Grid.Column="0" Source="ic_list.png" WidthRequest="20" HeightRequest="20"
                                               VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" Style="{StaticResource ItemTitle}" FontSize="14" />
                                            <Label Text="{Binding Caption}" Style="{StaticResource HintText}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
