<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:TaskManager.Mobile.Localization"
             x:Class="TaskManager.Mobile.Pages.TaskSummaryPage"
             Title="{loc:T TaskSummaryTitle}">

    <!--
        La tarea de un vistazo, de solo lectura. Editar es un boton aparte (el lapiz de la
        cabecera), que lleva al formulario de siempre. Lo pidio un probador el 2026-11-08: tocar una
        tarea para verla no tiene que ser entrar a editarla.
    -->
    <ContentPage.ToolbarItems>
        <ToolbarItem AutomationId="SummaryEdit" IconImageSource="ic_edit_w.png"
                     Text="{loc:T EditTaskTooltip}" Clicked="OnEditClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16" Spacing="12">
                    <Label x:Name="TitleLabel" AutomationId="SummaryTitle" FontSize="20"
                           FontAttributes="Bold" LineBreakMode="WordWrap" />

                    <!-- Estado, lista, fechas, repeticion, etiquetas y pasos: solo los que hay. -->
                    <VerticalStackLayout x:Name="LinesHost" Spacing="8" />

                    <Label x:Name="BareHint" Text="{loc:T SummaryNothingElse}"
                           Style="{StaticResource HintText}" IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" x:Name="StepsCard" IsVisible="False">
                <VerticalStackLayout Padding="16" Spacing="8">
                    <Label Text="{loc:T Steps}" Style="{StaticResource CardTitle}" />
                    <VerticalStackLayout x:Name="StepsHost" Spacing="6" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" x:Name="NotesCard" IsVisible="False">
                <VerticalStackLayout Padding="16" Spacing="8">
                    <Label Text="{loc:T Notes}" Style="{StaticResource CardTitle}" />
                    <Label x:Name="NotesLabel" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
