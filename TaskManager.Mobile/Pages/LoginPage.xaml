<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:TaskManager.Mobile.Localization"
             x:Class="TaskManager.Mobile.Pages.LoginPage"
             Title="{loc:T YourAccount}"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto,*" Padding="28">

        <VerticalStackLayout Grid.Row="1" Spacing="18">

            <Image Source="about_logo.png" HeightRequest="96" WidthRequest="96" HorizontalOptions="Center" />

            <Label Text="Task Manager"
                   FontSize="26" FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center" />

            <Label Text="{loc:T LoginPitch}"
                   Style="{StaticResource HintText}"
                   HorizontalTextAlignment="Center" />

            <Button x:Name="GoogleButton"
                    Text="{loc:T ContinueGoogle}"
                    ImageSource="ic_google_w.png"
                    ContentLayout="Left,10"
                    Clicked="OnGoogleClicked"
                    HorizontalOptions="Fill" />

            <Button x:Name="MicrosoftButton"
                    Text="{loc:T ContinueMicrosoft}"
                    ImageSource="ic_microsoft.png"
                    ContentLayout="Left,10"
                    Style="{StaticResource OutlineButton}"
                    Clicked="OnMicrosoftClicked"
                    HorizontalOptions="Fill" />

            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />

            <Label x:Name="StatusLabel"
                   Style="{StaticResource HintText}"
                   HorizontalTextAlignment="Center"
                   IsVisible="False" />

            <!-- No hay "seguir sin cuenta": la entrada es obligatoria (AuthOptions). -->
            <Label Text="{loc:T SignInRequiredHint}"
                   Style="{StaticResource HintText}"
                   FontSize="11"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
