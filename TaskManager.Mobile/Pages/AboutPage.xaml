<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:TaskManager.Mobile.Localization"
             x:Class="TaskManager.Mobile.Pages.AboutPage"
             Title="{loc:T MenuAbout}">

    <!-- Estructura canonica de la pantalla Acerca de (constitucion A.9 y Mobile 7). -->
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Cabecera -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="30,25" Spacing="10">
                    <Image Source="about_logo.png" HeightRequest="84" WidthRequest="84" HorizontalOptions="Center" />
                    <Label Text="Task Manager"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" />
                    <Label x:Name="VersionLabel" Style="{StaticResource HintText}" FontSize="15" HorizontalOptions="Center" />
                    <Label Text="{loc:T AboutDescription}"
                           Style="{StaticResource HintText}" HorizontalTextAlignment="Center" />
                    <Label Text="{loc:T Publisher}" Style="{StaticResource HintText}" HorizontalOptions="Center" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Contacto -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="12">
                    <Label Text="{loc:T Contact}" Style="{StaticResource CardTitle}" />
                    <Button Text="{loc:T WriteAuthor}"
                            Style="{StaticResource OutlineButton}"
                            ImageSource="ic_edit.png"
                            ContentLayout="Left,8"
                            Clicked="OnContactClicked"
                            HorizontalOptions="Fill" />
                    <Label Text="{loc:T ContactHint}" Style="{StaticResource HintText}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Idioma: la pantalla Acerca de es homogenea en todas las apps y lleva selector
                 (constitucion Mobile 7). -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="12">
                    <Label Text="{loc:T LanguageTitle}" Style="{StaticResource CardTitle}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" x:Name="SpanishButton" Text="Español"
                                Style="{StaticResource OutlineButton}" Clicked="OnSpanishClicked" />
                        <Button Grid.Column="1" x:Name="EnglishButton" Text="English"
                                Style="{StaticResource OutlineButton}" Clicked="OnEnglishClicked" />
                    </Grid>
                    <Label Text="{loc:T LanguageHint}" Style="{StaticResource HintText}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Privacidad -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="10">
                    <Label Text="{loc:T Privacy}" Style="{StaticResource CardTitle}" TextColor="{StaticResource Success}" />
                    <Label Style="{StaticResource BodyText}" FontSize="13"
                           Text="{loc:T PrivacyText}" />
                </VerticalStackLayout>
            </Border>

            <!-- Licencia -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="10">
                    <Label Text="{loc:T License}" Style="{StaticResource CardTitle}" />
                    <Label Style="{StaticResource BodyText}" FontSize="13"
                           Text="{loc:T LicenseText}" />
                    <Label Text="{loc:T LicenseLine}" Style="{StaticResource HintText}" FontSize="11" />
                </VerticalStackLayout>
            </Border>

            <!-- Aviso legal. Es obligatorio y va el ultimo (constitucion 6 y A.9): el descargo de
                 responsabilidad sobre fondo de aviso, rematado con el recuadro rojo. La misma
                 tarjeta, con las mismas palabras, que en las demas aplicaciones. -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="25,20" Spacing="12">
                    <Label Text="{loc:T LegalTitle}" Style="{StaticResource CardTitle}"
                           TextColor="{StaticResource Danger}" />

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurfaceLight}, Dark={StaticResource WarningSurfaceDark}}"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{loc:T LegalText1}" Style="{StaticResource BodyText}" FontSize="13" />
                            <Label Text="{loc:T LegalText2}" Style="{StaticResource BodyText}" FontSize="13" />

                            <Border BackgroundColor="{StaticResource Danger}" Stroke="Transparent"
                                    StrokeThickness="0" Padding="12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Label Text="{loc:T WarningText}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}"
                                       HorizontalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
