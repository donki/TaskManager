<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:TaskManager.Mobile.Localization"
             x:Class="TaskManager.Mobile.Pages.SettingsPage"
             Title="{loc:T MenuSettings}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Cuenta: se entra con Google o con Microsoft, y cada una tiene sus listas. Es lo
                 que guarda el usuario y lo que permite compartir grupos. -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label Text="{loc:T YourAccount}" Style="{StaticResource CardTitle}" />

                    <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                        <!-- La foto de la cuenta, recortada en circulo. Si no hay o no carga, se ve
                             debajo el icono generico: nunca se queda un hueco. -->
                        <Image Grid.Column="0" Source="ic_account.png" WidthRequest="28" HeightRequest="28"
                               VerticalOptions="Center" />
                        <Border Grid.Column="0" x:Name="AvatarFrame" IsVisible="False"
                                WidthRequest="40" HeightRequest="40" Padding="0"
                                Stroke="Transparent" StrokeThickness="0"
                                VerticalOptions="Center" HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Image x:Name="AvatarImage" Aspect="AspectFill"
                                   WidthRequest="40" HeightRequest="40" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="AccountNameLabel" Style="{StaticResource ItemTitle}" />
                            <Label x:Name="AccountEmailLabel" Style="{StaticResource ItemSubtitle}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Un boton por cuenta: pulsar uno entra con ese proveedor, se estuviera
                         dentro con el otro o con ninguno. Cada cuenta tiene sus listas, asi que
                         esto es lo que hace de interruptor entre una y otra. -->
                    <Button x:Name="GoogleButton"
                            Text="{loc:T ContinueGoogle}"
                            ImageSource="ic_google_w.png"
                            ContentLayout="Left,10"
                            Clicked="OnGoogleClicked"
                            HorizontalOptions="Fill" />

                    <Button x:Name="MicrosoftButton"
                            Text="{loc:T ContinueMicrosoft}"
                            ImageSource="ic_microsoft.png"
                            ContentLayout="Left,10"
                            Style="{StaticResource OutlineButton}"
                            Clicked="OnMicrosoftClicked"
                            HorizontalOptions="Fill" />

                    <Button x:Name="SignOutButton"
                            Text="{loc:T SignOut}"
                            Style="{StaticResource OutlineButton}"
                            Clicked="OnSignOutClicked"
                            HorizontalOptions="Fill"
                            IsVisible="False" />

                    <Label x:Name="AccountHintLabel" Style="{StaticResource HintText}" />
                </VerticalStackLayout>
            </Border>

            <!-- Recordatorios -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label Text="{loc:T Reminders}" Style="{StaticResource CardTitle}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:T RemindPending}"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="NotifySwitch" Toggled="OnNotifyToggled" />
                    </Grid>

                    <!-- Cada cuanto insistir con las pendientes. -->
                    <Grid ColumnDefinitions="*,Auto" x:Name="SnoozeRow" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="{loc:T SnoozeLabel}" VerticalOptions="Center" />
                        <Picker Grid.Column="1" x:Name="SnoozePicker" WidthRequest="150"
                                SelectedIndexChanged="OnSnoozeChanged" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" x:Name="NotifyHourRow">
                        <Label Grid.Column="0" Text="{loc:T ReminderHour}" VerticalOptions="Center" />
                        <TimePicker Grid.Column="1" x:Name="NotifyTimePicker" Format="HH:mm"
                                    PropertyChanged="OnNotifyTimeChanged" />
                    </Grid>

                    <Label Style="{StaticResource HintText}"
                           Text="{loc:T ReminderHelp}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label Text="{loc:T Celebration}" Style="{StaticResource CardTitle}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:T Vibration}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="HapticsSwitch" Toggled="OnHapticsToggled" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:T Sound}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="SoundSwitch" Toggled="OnSoundToggled" />
                    </Grid>
                    <Label Text="{loc:T SoundLater}"
                           Style="{StaticResource HintText}" />
                </VerticalStackLayout>
            </Border>


            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="16" Spacing="10">
                    <Label Text="{loc:T Identity}" Style="{StaticResource CardTitle}" />
                    <Border Style="{StaticResource Card}" Padding="12,0">
                        <Entry x:Name="DisplayNameEntry" Placeholder="{loc:T DisplayNamePlaceholder}"
                               Completed="OnSaveName" />
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
