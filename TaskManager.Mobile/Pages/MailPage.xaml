<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:TaskManager.Mobile.Pages"
             x:Class="TaskManager.Mobile.Pages.MailPage"
             Title="Correo">

    <Grid RowDefinitions="Auto,*">

        <!-- Cuenta -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="12,12,12,6" x:Name="AccountCard">
            <VerticalStackLayout Padding="16" Spacing="10">
                <Label Text="Buzón" Style="{StaticResource CardTitle}" />

                <Border Style="{StaticResource Card}" Padding="12,0">
                    <Entry x:Name="AddressEntry" Placeholder="tu@correo.com" Keyboard="Email"
                           Completed="OnAddressCompleted" />
                </Border>

                <Border Style="{StaticResource Card}" Padding="12,0">
                    <Entry x:Name="PasswordEntry" Placeholder="Contraseña de aplicación" IsPassword="True" />
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,0">
                        <Entry x:Name="ImapHostEntry" Placeholder="imap.servidor.com" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,0">
                        <Entry x:Name="ImapPortEntry" Placeholder="993" Keyboard="Numeric" />
                    </Border>
                </Grid>

                <Label x:Name="ProviderHint" Style="{StaticResource HintText}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" x:Name="StatusLabel" Style="{StaticResource HintText}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1" x:Name="ConnectButton" Text="Leer buzón"
                            ImageSource="ic_refresh_w.png" ContentLayout="Left,8"
                            Clicked="OnConnectClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Mensajes -->
        <RefreshView Grid.Row="1" x:Name="Refresher" Refreshing="OnRefreshing">
            <CollectionView x:Name="MailView" SelectionMode="None" Margin="12,0,12,12">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8">
                        <Label Text="Sin correos que enseñar" Style="{StaticResource CardTitle}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Pon los datos del buzón y pulsa «Leer buzón»."
                               Style="{StaticResource HintText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="pages:MailRow">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Subject}" Style="{StaticResource ItemTitle}"
                                           FontAttributes="{Binding Weight}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding FromAndDate}" Style="{StaticResource ItemSubtitle}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Preview}" Style="{StaticResource HintText}"
                                           MaxLines="2" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <!-- Convertir el correo en tarea, con su contexto -->
                                <ImageButton Grid.Column="1"
                                             Style="{StaticResource HeaderIconButton}"
                                             Source="ic_add_w.png"
                                             BackgroundColor="{StaticResource Primary}"
                                             CommandParameter="{Binding Uid}"
                                             Clicked="OnCreateTaskClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
