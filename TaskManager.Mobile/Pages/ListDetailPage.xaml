<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:TaskManager.Mobile.Localization"
             xmlns:models="clr-namespace:TaskManager.Mobile.Models"
             xmlns:controls="clr-namespace:TaskManager.Mobile.Controls"
             x:Class="TaskManager.Mobile.Pages.ListDetailPage"
             Title="Lista">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="ic_edit_w.png" Clicked="OnRenameListClicked" />
        <ToolbarItem IconImageSource="ic_refresh_w.png" Clicked="OnRefreshClicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Captura rapida dentro de la lista -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="16,12,16,8">
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,0">
                    <Entry x:Name="QuickAdd"
                           Placeholder="{loc:T AddTaskPlaceholder}"
                           ReturnType="Done"
                           Completed="OnAddClicked" />
                </Border>
                <ImageButton Grid.Column="1" Style="{StaticResource HeaderIconButton}"
                             Source="ic_add_w.png" BackgroundColor="{StaticResource Primary}"
                             Clicked="OnAddClicked" />
            </Grid>

            <!-- Buscador: mira en todo el texto de la tarea. -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,0" Margin="16,0,16,8">
                <Entry x:Name="SearchEntry"
                       Placeholder="{loc:T SearchPlaceholder}"
                       ClearButtonVisibility="WhileEditing"
                       TextChanged="OnSearchChanged" />
            </Border>

            <!-- Se ordena arrastrando: manten pulsada una tarea y subela o bajala. -->
            <CollectionView Grid.Row="2" x:Name="TasksView" SelectionMode="None" Margin="8,0,8,8"
                            CanReorderItems="True" ReorderCompleted="OnReorderCompleted">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8">
                        <Label Text="{loc:T ListDetailEmptyTitle}" Style="{StaticResource CardTitle}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{loc:T ListDetailEmptyMessage}" Style="{StaticResource HintText}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TaskRow">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                            <VerticalStackLayout Padding="6,8,8,8" Spacing="4">

                                <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="2">
                                    <ImageButton Grid.Column="0"
                                                 Style="{StaticResource RowIconButton}"
                                                 Source="{Binding StateIcon}"
                                                 CommandParameter="{Binding Id}"
                                                 Clicked="OnToggleDoneClicked" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"
                                                         Opacity="{Binding Opacity}">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTaskTapped" CommandParameter="{Binding Id}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Text="{Binding Title}"
                                               Style="{StaticResource ItemTitle}"
                                               TextDecorations="{Binding Decoration}" />
                                        <Label Text="{Binding TagsCaption}"
                                               Style="{StaticResource HintText}"
                                               IsVisible="{Binding HasTags}" />
                                        <Label Text="{Binding ScheduleCaption}"
                                               Style="{StaticResource HintText}"
                                               IsVisible="{Binding HasSchedule}" />
                                        <Label Text="{Binding StepsCaption}"
                                               Style="{StaticResource ItemSubtitle}"
                                               IsVisible="{Binding HasSteps}" />
                                    </VerticalStackLayout>

                                    <!-- Estrella: llevar o quitar de Mi Dia -->
                                    <ImageButton Grid.Column="2"
                                                 Style="{StaticResource RowIconButton}"
                                                 Source="{Binding MyDayIcon}"
                                                 CommandParameter="{Binding Id}"
                                                 Clicked="OnToggleMyDayClicked" />

                                </Grid>

                                <!-- Micro-pasos: cada uno suma su parte de XP al marcarse -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps}"
                                                     IsVisible="{Binding ShowSteps}"
                                                     Margin="44,0,0,0" Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:StepRow">
                                            <Grid ColumnDefinitions="36,*" ColumnSpacing="2">
                                                <ImageButton Grid.Column="0"
                                                             Style="{StaticResource RowIconButton}"
                                                             HeightRequest="32" WidthRequest="32"
                                                             Source="{Binding StateIcon}"
                                                             CommandParameter="{Binding Id}"
                                                             Clicked="OnToggleStepClicked" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       Style="{StaticResource ItemSubtitle}"
                                                       VerticalOptions="Center"
                                                       Opacity="{Binding Opacity}"
                                                       TextDecorations="{Binding Decoration}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Aviso de que se esta hablando con el servidor. Flota arriba y no bloquea nada. -->
        <controls:RefreshingBadge x:Name="RefreshingBadge" />

        <controls:CelebrationView x:Name="Celebration" />
    </Grid>
</ContentPage>
