<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:TaskManager.Mobile.Localization"
             xmlns:models="clr-namespace:TaskManager.Mobile.Models"
             xmlns:controls="clr-namespace:TaskManager.Mobile.Controls"
             x:Class="TaskManager.Mobile.Pages.MyTasksPage"
             Title="{loc:T MenuMyTasks}">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- Cuantas hay con el filtro puesto -->
            <VerticalStackLayout Grid.Row="0" Padding="16,12,16,4" Spacing="2">
                <Label x:Name="FilterLabel" Style="{StaticResource HintText}" />
                <Label x:Name="SummaryLabel" Style="{StaticResource CardTitle}" />
            </VerticalStackLayout>

            <!-- Captura rapida -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="16,8">
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,0">
                    <Entry x:Name="QuickAdd"
                           Placeholder="{loc:T MyDayAddPlaceholder}"
                           ReturnType="Done"
                           Completed="OnAddClicked" />
                </Border>
                <ImageButton Grid.Column="1" Style="{StaticResource HeaderIconButton}"
                             Source="ic_add_w.png" BackgroundColor="{StaticResource Primary}"
                             Clicked="OnAddClicked" />
            </Grid>

            <!-- Filtros: una fila que se desliza. Son ocho, no caben en pantalla de otra forma,
                 y partirlos en un desplegable esconderia justo lo que se viene a usar. -->
            <VerticalStackLayout Grid.Row="2" Spacing="6">
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                            Padding="16,0,16,0">
                    <HorizontalStackLayout x:Name="FilterBox" Spacing="8" />
                </ScrollView>

                <!-- Etiquetas en uso. La fila no aparece si no hay ninguna: un filtro vacio solo
                     ocupa sitio. -->
                <ScrollView x:Name="TagFilterScroll" Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never" Padding="16,0,16,8" IsVisible="False">
                    <HorizontalStackLayout x:Name="TagFilterBox" Spacing="8" />
                </ScrollView>
            </VerticalStackLayout>

            <RefreshView Grid.Row="3" x:Name="Refresher" Refreshing="OnRefreshing">
                <CollectionView x:Name="TasksView" SelectionMode="None" Margin="8,0,8,8">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="24" Spacing="8">
                            <Label Text="{loc:T NoTasksForFilter}"
                                   Style="{StaticResource HintText}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TaskRow">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="4" Padding="6,8,8,8">

                                    <ImageButton Grid.Column="0"
                                                 Style="{StaticResource RowIconButton}"
                                                 Source="{Binding StateIcon}"
                                                 CommandParameter="{Binding Id}"
                                                 Clicked="OnToggleDoneClicked" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"
                                                         Opacity="{Binding Opacity}">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTaskTapped" CommandParameter="{Binding Id}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Text="{Binding Title}"
                                               Style="{StaticResource ItemTitle}"
                                               TextDecorations="{Binding Decoration}" />
                                        <Label Text="{Binding ScheduleCaption}"
                                               Style="{StaticResource HintText}"
                                               IsVisible="{Binding HasSchedule}" />
                                        <Label Text="{Binding TagsCaption}"
                                               Style="{StaticResource HintText}"
                                               IsVisible="{Binding HasTags}" />
                                        <Label Text="{Binding StepsCaption}"
                                               Style="{StaticResource ItemSubtitle}"
                                               IsVisible="{Binding HasSteps}" />
                                        <Label Text="{Binding ListName}"
                                               Style="{StaticResource HintText}"
                                               IsVisible="{Binding ShowListName}" />
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <controls:CelebrationView x:Name="Celebration" />
    </Grid>
</ContentPage>
