<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:TaskManager.Mobile.Localization"
             xmlns:models="clr-namespace:TaskManager.Mobile.Models"
             xmlns:controls="clr-namespace:TaskManager.Mobile.Controls"
             x:Class="TaskManager.Mobile.Pages.MyTasksPage"
             Title="{loc:T MenuMyTasks}">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="ic_refresh_w.png" Clicked="OnRefreshClicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- Cuantas hay con el filtro puesto -->
            <VerticalStackLayout Grid.Row="0" Padding="16,12,16,4" Spacing="2">
                <Label x:Name="FilterLabel" Style="{StaticResource HintText}" />
                <Label x:Name="SummaryLabel" Style="{StaticResource CardTitle}" />
            </VerticalStackLayout>

            <!-- Captura rapida -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="16,8">
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,0">
                    <Entry x:Name="QuickAdd"
                           Placeholder="{loc:T MyDayAddPlaceholder}"
                           ReturnType="Done"
                           Completed="OnAddClicked" />
                </Border>
                <ImageButton Grid.Column="1" Style="{StaticResource HeaderIconButton}"
                             Source="ic_add_w.png" BackgroundColor="{StaticResource Primary}"
                             Clicked="OnAddClicked" />

                <!-- Modo seleccion. Se enciende con un boton y no con una pulsacion larga: la
                     pulsacion larga no se ve por ninguna parte y en MAUI hay que reimplementarla
                     con gestos nativos de Android, asi que sale caro y ademas queda escondido. -->
                <ImageButton Grid.Column="2" x:Name="SelectModeButton"
                             Style="{StaticResource HeaderIconButton}"
                             Source="ic_select.png"
                             Clicked="OnSelectModeClicked" />
            </Grid>

            <!-- Filtros: una fila que se desliza. Son ocho, no caben en pantalla de otra forma,
                 y partirlos en un desplegable esconderia justo lo que se viene a usar. -->
            <VerticalStackLayout Grid.Row="2" Spacing="6">

                <!-- Buscador: mira en el titulo, las notas, las etiquetas, los pasos y los
                     adjuntos. Busca al escribir. -->
                <Border Style="{StaticResource Card}" Padding="12,0" Margin="16,0,16,2">
                    <Entry x:Name="SearchEntry"
                           Placeholder="{loc:T SearchPlaceholder}"
                           ClearButtonVisibility="WhileEditing"
                           TextChanged="OnSearchChanged" />
                </Border>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                            Padding="16,0,16,0">
                    <HorizontalStackLayout x:Name="FilterBox" Spacing="8" />
                </ScrollView>

                <!-- Etiquetas en uso. La fila no aparece si no hay ninguna: un filtro vacio solo
                     ocupa sitio. -->
                <ScrollView x:Name="TagFilterScroll" Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never" Padding="16,0,16,8" IsVisible="False">
                    <HorizontalStackLayout x:Name="TagFilterBox" Spacing="8" />
                </ScrollView>
            </VerticalStackLayout>

            <RefreshView Grid.Row="3" x:Name="Refresher" Refreshing="OnRefreshing">
                <CollectionView x:Name="TasksView" SelectionMode="None" Margin="8,0,8,8">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="24" Spacing="8">
                            <Label Text="{loc:T NoTasksForFilter}"
                                   Style="{StaticResource HintText}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TaskRow">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="Auto,44,*" ColumnSpacing="4" Padding="6,8,8,8">

                                    <!-- Solo mientras se marcan varias. Con IsVisible="False" la
                                         columna Auto queda a cero y la fila es la de siempre. -->
                                    <CheckBox Grid.Column="0"
                                              IsVisible="{Binding Selecting}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              CheckedChanged="OnRowCheckChanged"
                                              VerticalOptions="Center" />

                                    <ImageButton Grid.Column="1"
                                                 Style="{StaticResource RowIconButton}"
                                                 Source="{Binding StateIcon}"
                                                 CommandParameter="{Binding Id}"
                                                 Clicked="OnToggleDoneClicked" />

                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center"
                                                         Opacity="{Binding Opacity}">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTaskTapped" CommandParameter="{Binding Id}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Text="{Binding Title}"
                                               Style="{StaticResource ItemTitle}"
                                               TextDecorations="{Binding Decoration}" />
                                        <Label Text="{Binding ScheduleCaption}"
                                               Style="{StaticResource HintText}"
                                               IsVisible="{Binding HasSchedule}" />
                                        <Label Text="{Binding TagsCaption}"
                                               Style="{StaticResource HintText}"
                                               IsVisible="{Binding HasTags}" />
                                        <Label Text="{Binding StepsCaption}"
                                               Style="{StaticResource ItemSubtitle}"
                                               IsVisible="{Binding HasSteps}" />
                                        <Label Text="{Binding ListName}"
                                               Style="{StaticResource HintText}"
                                               IsVisible="{Binding ShowListName}" />
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- Barra de acciones de la seleccion. Va abajo y por encima de la lista: es donde llega
             el pulgar, y asi no empuja la lista hacia arriba al aparecer. -->
        <Border x:Name="SelectionBar" IsVisible="False"
                Style="{StaticResource Card}" Margin="8" Padding="8,6"
                VerticalOptions="End">
            <VerticalStackLayout Spacing="4">
                <Label x:Name="SelectionLabel" Style="{StaticResource HintText}" Margin="6,0,0,0" />
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="4">
                        <ImageButton Style="{StaticResource RowIconButton}" Source="ic_check.png"
                                     Clicked="OnBulkDoneClicked" />
                        <ImageButton Style="{StaticResource RowIconButton}" Source="ic_undo.png"
                                     Clicked="OnBulkPendingClicked" />
                        <ImageButton Style="{StaticResource RowIconButton}" Source="ic_pin.png"
                                     Clicked="OnBulkPinClicked" />
                        <ImageButton Style="{StaticResource RowIconButton}" Source="ic_tag.png"
                                     Clicked="OnBulkTagClicked" />
                        <ImageButton Style="{StaticResource RowIconButton}" Source="ic_list.png"
                                     Clicked="OnBulkMoveClicked" />
                        <ImageButton Style="{StaticResource RowIconButton}" Source="ic_delete_danger.png"
                                     Clicked="OnBulkDeleteClicked" />
                        <ImageButton Style="{StaticResource RowIconButton}" Source="ic_close.png"
                                     Clicked="OnSelectModeClicked" />
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <controls:CelebrationView x:Name="Celebration" />
    </Grid>
</ContentPage>
