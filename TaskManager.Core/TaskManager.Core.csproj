<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TaskManager.Core</RootNamespace>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Socratic</Authors>
    <Company>Socratic</Company>
    <Description>Modelo, almacen local, gamificacion y desglose con IA compartidos por las apps de Task Manager.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      sqlite-net-pcl (MIT) + bundle_green (Apache-2.0): almacen local en las dos plataformas.
      Compatible con la regla MIT/monetizable (constitucion 4). Ver THIRD-PARTY-NOTICES.md.
    -->
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <!--
      NO subir los binarios nativos por su cuenta. Se intento fijar lib.e_sqlite3 a 2.1.13 para
      quitar el aviso NU1903 (GHSA-2m69-gcr7-jv3q), pero bundle_green no pasa de 2.1.11: la mezcla
      compila y arranca en Windows, y en Android revienta al abrir con
      «TypeInitializationException: SQLite.SQLiteConnection» porque el bundle no encuentra el
      nativo que espera. Comprobado en dispositivo el 2026-08-29.

      El aviso se queda a la vista, sin silenciar, hasta que SQLitePCLRaw publique un bundle nuevo:
      es una version de SQLite con vulnerabilidad conocida y no conviene perderlo de vista.
    -->
    <!--
      MailKit (MIT): cliente IMAP para convertir correos en tareas. Es la biblioteca estandar de
      .NET para esto y cumple la regla MIT/monetizable (constitucion 4).
    -->
    <PackageReference Include="MailKit" Version="4.17.0" />
  </ItemGroup>

  <!-- Identificadores de OAuth: se generan al compilar, nunca viven en el repositorio. -->
  <Import Project="$(MSBuildThisFileDirectory)..\oauth.props" />

</Project>
