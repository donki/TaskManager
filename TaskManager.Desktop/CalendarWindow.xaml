<Window x:Class="TaskManager.Desktop.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TaskManager.Desktop.Localization"
        Title="{loc:T MenuCalendar}"
        Width="760" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackground}">

    <Grid Margin="16" ColumnDefinitions="*,260">

        <!-- Mes -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="0,0,16,0">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                <Button Grid.Column="0" Content="&#x2039;" FontSize="20" Width="34" Height="30"
                        ToolTip="{loc:T PreviousMonth}" Click="OnPreviousMonthClick" />

                <TextBlock Grid.Column="1" x:Name="MonthLabel" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}" />

                <Button Grid.Column="2" Content="&#x203A;" FontSize="20" Width="34" Height="30"
                        ToolTip="{loc:T NextMonth}" Click="OnNextMonthClick" />
            </Grid>

            <UniformGrid Grid.Row="1" x:Name="WeekdayRow" Columns="7" Margin="0,0,0,4" />

            <UniformGrid Grid.Row="2" x:Name="MonthGrid" Columns="7" Rows="6" />
        </Grid>

        <!-- Tareas del dia elegido -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" x:Name="DayLabel" FontSize="14" FontWeight="SemiBold"
                       Margin="0,0,0,8" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimary}" />

            <ListBox Grid.Row="1" x:Name="DayTasks"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{Binding ListName}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1" x:Name="EmptyLabel" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Top" Margin="4,10,0,0"
                       Foreground="{DynamicResource TextSecondary}" />
        </Grid>
    </Grid>
</Window>
