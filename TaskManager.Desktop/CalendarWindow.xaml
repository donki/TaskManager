<Window x:Class="TaskManager.Desktop.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TaskManager.Desktop.Localization"
        xmlns:views="clr-namespace:TaskManager.Desktop.Views"
        Title="{loc:T MenuCalendar}"
        Width="760" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackground}">

    <!--
        El mes lo pinta el control, que es el mismo que lleva la pestaña «Calendario» de la ventana
        principal. Esta ventana existe para el menu de la bandeja: desde ahi se quiere ver el mes sin
        abrir la ventana grande, y no cabe en el panel, que esta pensado para entrar y salir en dos
        segundos.
    -->
    <views:CalendarView x:Name="View" Margin="16" />
</Window>
