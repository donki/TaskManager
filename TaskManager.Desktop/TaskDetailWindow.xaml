<Window x:Class="TaskManager.Desktop.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TaskManager.Desktop.Localization"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="{loc:T TaskTitle}"
        Width="1060" Height="800"
        MinWidth="820" MinHeight="620"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackground}">

    <!--
        El detalle de una tarea en Windows, con LOS MISMOS campos que TaskDetailPage en Android y
        en el mismo orden de lectura: que hay que hacer, cuando, con que etiqueta, con que material
        y en que pasos.

        DOS COLUMNAS, no una. Antes era una sola columna estrecha —la del movil, tal cual— en una
        pantalla de escritorio: no cabia ni la mitad y habia que ir bajando para ver si una tarea
        tenia pasos. Aqui sobra ancho y falta alto, asi que lo que en el movil va uno debajo de otro
        aqui va al lado:

          * Izquierda, lo que se escribe: titulo, lista, notas, y las fechas con la repeticion.
          * Derecha, lo que se acumula: etiquetas, adjuntos y pasos. Los pasos se llevan el hueco
            que sobre, porque son los que crecen.

        Cada columna se desplaza por su cuenta: llenar de pasos la derecha no debe mover el titulo
        de sitio. Y la ventana se puede agrandar; con el minimo puesto no se puede dejar tan
        estrecha que las dos columnas se pisen.
    -->

    <DockPanel Margin="16">

        <!-- Acciones abajo: solo iconos, nunca palabras (constitucion 7). -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
            <TextBlock Grid.Column="0" x:Name="StatusLabel" Style="{StaticResource HintText}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="DeleteButton" Style="{StaticResource DangerIconButton}"
                    Content="&#xE74D;" ToolTip="{loc:T DeleteTask}" Margin="0,0,8,0"
                    Click="OnDeleteClick" />
            <Button Grid.Column="2" x:Name="SaveButton" Style="{StaticResource IconButton}"
                    Content="&#xE73E;" ToolTip="{loc:T Save}" Click="OnSaveClick" />
        </Grid>

        <Grid ColumnDefinitions="1.15*,12,*">

            <!-- ================= Izquierda: lo que se escribe ================= -->
            <!--
                Las notas se llevan el alto que sobre. Con la tarjeta de tamano fijo quedaba un
                hueco muerto debajo de la repeticion mientras la caja de notas seguia siendo un
                sello: al agrandar la ventana lo unico que crecia era el vacio.
            -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto" Margin="0,0,10,0">

                    <!-- Titulo, lista y notas -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Top">
                            <!-- Marcar hecha sin salir del detalle: si se ha entrado a repasarla,
                                 tener que cerrar para tacharla sobra. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox Style="{StaticResource CheckBoxBaseStyle}" x:Name="DoneCheck" Content="{loc:T MarkDone}"
                                          Click="OnDoneToggled" />
                                <CheckBox Style="{StaticResource CheckBoxBaseStyle}" x:Name="PinCheck" Content="{loc:T MarkPinned}"
                                          Margin="20,0,0,0" Click="OnPinToggled" />
                            </StackPanel>

                            <TextBlock Text="{loc:T TaskTitle}" Style="{StaticResource HintText}" />
                            <!-- Se parte en varias lineas, pero NO acepta saltos: un titulo largo hay que
                                 poder leerlo entero, y a la vez tiene que seguir siendo una linea de
                                 texto en todas las listas donde salga. -->
                            <TextBox x:Name="TitleBox" Style="{StaticResource Field}" Margin="0,4,0,10"
                                     TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="90"
                                     VerticalScrollBarVisibility="Auto" />

                            <TextBlock Text="{loc:T TaskList}" Style="{StaticResource HintText}" />
                            <hc:ComboBox x:Name="ListBox" Margin="0,4,0,10" />

                          </StackPanel>

                            <TextBlock DockPanel.Dock="Top" Text="{loc:T Notes}"
                                       Style="{StaticResource HintText}" />
                            <TextBox x:Name="NotesBox" Style="{StaticResource FieldMultiline}"
                                     MinHeight="120" Margin="0,4,0,0" />
                        </DockPanel>
                    </Border>

                    <!-- Cuando: plazo, planificacion y repeticion -->
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:T WhenTitle}" Style="{StaticResource CardTitle}"
                                       Margin="0,0,0,8" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                <TextBlock Grid.Column="0" Text="{loc:T DueDate}" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource CheckBoxBaseStyle}" Grid.Column="1" x:Name="DueCheck" Click="OnDueToggled" />
                            </Grid>
                            <Grid x:Name="DueRow" Visibility="Collapsed" Margin="0,0,0,12"
                                  ColumnDefinitions="*,Auto">
                                <hc:DatePicker Grid.Column="0" x:Name="DuePicker" />
                                <hc:TimePicker Grid.Column="1" x:Name="DueTime" Width="110" Margin="8,0,0,0"
                                               />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                <TextBlock Grid.Column="0" Text="{loc:T PlannedFor}" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource CheckBoxBaseStyle}" Grid.Column="1" x:Name="PlannedCheck" Click="OnPlannedToggled" />
                            </Grid>
                            <Grid x:Name="PlannedRow" Visibility="Collapsed" ColumnDefinitions="*,Auto">
                                <hc:DatePicker Grid.Column="0" x:Name="PlannedPicker" />
                                <hc:TimePicker Grid.Column="1" x:Name="PlannedTime" Width="110" Margin="8,0,0,0"
                                               />
                            </Grid>
                            <TextBlock Text="{loc:T PlannedHelp}" Style="{StaticResource HintText}" Margin="0,4,0,12" />

                            <Border Height="1" Background="{DynamicResource Separator}" Margin="0,0,0,12" />

                            <TextBlock Text="{loc:T Recurrence}" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                            <Grid ColumnDefinitions="*,Auto" >
                                <hc:ComboBox Grid.Column="0" x:Name="RecurrenceBox"
                                          SelectionChanged="OnRecurrenceChanged" />
                                <StackPanel Grid.Column="1" x:Name="IntervalPanel" Orientation="Horizontal"
                                            Margin="8,0,0,0" Visibility="Collapsed">
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE949;"
                                            Click="OnIntervalDown" />
                                    <TextBlock x:Name="IntervalLabel" Width="26" TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE948;"
                                            Click="OnIntervalUp" />
                                </StackPanel>
                            </Grid>
                            <!-- Dias de la semana: solo con repeticion diaria o semanal. -->
                            <StackPanel x:Name="WeekdaysBox" Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="Collapsed" />

                            <!-- Dia del mes: solo con repeticion mensual. -->
                            <Grid x:Name="MonthDayRow" Margin="0,8,0,0" Visibility="Collapsed"
                                  ColumnDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{loc:T MonthDayLabel}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <hc:ComboBox Grid.Column="1" x:Name="MonthDayBox" Width="130"
                                          SelectionChanged="OnMonthDayChanged" />

                                <!-- El mes solo con repeticion anual: «cada año el 15 de septiembre». -->
                                <TextBlock Grid.Column="2" x:Name="MonthLabelText" Text="{loc:T MonthLabel}"
                                           VerticalAlignment="Center" Margin="14,0,10,0"
                                           Visibility="Collapsed" />
                                <hc:ComboBox Grid.Column="3" x:Name="MonthBox" Width="140"
                                          Visibility="Collapsed" SelectionChanged="OnMonthChanged" />
                            </Grid>

                            <TextBlock x:Name="RecurrenceLabel" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

            </Grid>

            <!-- ================= Derecha: lo que se acumula ================= -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">

                <!-- Etiquetas -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:T Tags}" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                        <!-- Las de ESTA tarea: pastilla con aspa para quitarla. -->
                        <hc:TagContainer x:Name="TagsContainer" Margin="0,0,0,6" />

                        <!-- Dar de alta una nueva: escribir y Enter, o el boton. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" x:Name="TagsBox" Style="{StaticResource Field}"
                                     KeyDown="OnNewTagKeyDown" />
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;"
                                    Margin="8,0,0,0" ToolTip="{loc:T AddTagTooltip}" Click="OnAddTagClick" />
                        </Grid>
                        <TextBlock Text="{loc:T TagsHelp}" Style="{StaticResource HintText}" Margin="0,4,0,6" />

                        <!-- Las que ya existen en otras tareas: pulsar una la pone o la quita. Sin
                             esto habria que reescribirlas y acordarse de como estaban escritas. -->
                        <ScrollViewer x:Name="KnownTagsScroll" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12"
                                      Visibility="Collapsed">
                            <StackPanel x:Name="KnownTagsBox" Orientation="Horizontal" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Enlaces y ficheros -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="{loc:T Attachments}"
                                       Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE71B;"
                                    ToolTip="{loc:T AddLinkTooltip}" Margin="0,0,8,0"
                                    Click="OnAddLinkClick" />
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8E5;"
                                    ToolTip="{loc:T AddFileTooltip}" Click="OnAddFileClick" />
                        </Grid>

                        <TextBlock x:Name="NoAttachmentsLabel" Text="{loc:T NoAttachments}"
                                   Style="{StaticResource HintText}" />

                        <ListBox x:Name="AttachmentsBox" Style="{StaticResource Rows}" MaxHeight="180"
                                 MouseDoubleClick="OnAttachmentDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2" Background="Transparent">
                                        <TextBlock Grid.Column="0" Text="{Binding Glyph}" Margin="0,0,8,0"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Primary}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <!-- Enlace: se pulsa una vez y se abre en el navegador. -->
                                            <TextBlock Style="{StaticResource ItemTitle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding LinkVisibility}">
                                                <Hyperlink NavigateUri="{Binding Link}"
                                                           RequestNavigate="OnLinkClick"
                                                           ToolTip="{loc:T OpenAttachmentTooltip}">
                                                    <!-- OneWay a la fuerza: Run.Text enlaza en dos sentidos por defecto y
                                                         Name es de solo lectura, asi que la ventana reventaba al
                                                         pintar la primera fila de adjuntos. -->
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>

                                            <!-- Fichero: doble clic, como en cualquier lista. -->
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding FileVisibility}"
                                                       ToolTip="{loc:T OpenAttachmentTooltip}" />
                                            <TextBlock Text="{Binding Caption}"
                                                       Style="{StaticResource ItemSubtitle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding CaptionVisibility}" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Style="{StaticResource RowIconButton}"
                                                Content="&#xE74D;" Foreground="{DynamicResource TextSecondary}"
                                                ToolTip="{loc:T DeleteAttachmentTooltip}"
                                                Tag="{Binding Id}" Click="OnDeleteAttachmentClick" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Pasos: se quedan con el hueco que sobre, que son los que crecen -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="{loc:T Steps}" Style="{StaticResource CardTitle}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="BreakdownButton" Style="{StaticResource IconButton}"
                                    Content="&#xE945;" ToolTip="{loc:T BreakdownTooltip}"
                                    Click="OnBreakdownClick" />
                        </Grid>

                        <!-- Anadir un paso a mano: escribir y Enter, o el boton. -->
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <TextBox Grid.Column="0" x:Name="NewStepBox" Style="{StaticResource Field}"
                                     KeyDown="OnNewStepKeyDown" />
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;"
                                    Margin="8,0,0,0" ToolTip="{loc:T AddStepTooltip}" Click="OnAddStepClick" />
                        </Grid>

                        <TextBlock DockPanel.Dock="Top" x:Name="NoStepsLabel" Text="{loc:T NoSteps}"
                                   Style="{StaticResource HintText}" />

                        <!--
                            ListBox y no ItemsControl: es lo que trae seleccion y, con los
                            manejadores de abajo, permite arrastrar un paso para reordenarlo. Los
                            pasos son el guion de como se hace algo, y un guion desordenado no sirve.
                        -->
                        <ListBox x:Name="StepsBox" Style="{StaticResource Rows}"
                                 MouseDoubleClick="OnStepDoubleClick"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="OnStepMouseDown"
                                 PreviewMouseMove="OnStepMouseMove"
                                 Drop="OnStepDrop">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,2"
                                          Background="Transparent">
                                        <TextBlock Grid.Column="0" Text="&#xE700;" Margin="0,0,6,0"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   ToolTip="{loc:T DragStepTooltip}" />
                                        <CheckBox Style="{StaticResource CheckBoxBaseStyle}" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  IsChecked="{Binding IsDone, Mode=OneWay}"
                                                  Tag="{Binding Id}" Click="OnStepToggled" />
                                        <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                   Style="{StaticResource ItemTitle}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                   TextDecorations="{Binding Decoration}"
                                                   Opacity="{Binding Opacity}"
                                                   ToolTip="{loc:T EditStepTooltip}" />
                                        <Button Grid.Column="3" Style="{StaticResource RowIconButton}"
                                                Content="&#xE74D;" Foreground="{DynamicResource TextSecondary}"
                                                ToolTip="{loc:T DeleteStepTooltip}"
                                                Tag="{Binding Id}" Click="OnDeleteStepClick" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

            </Grid>
        </Grid>
    </DockPanel>
</Window>
