<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!--
      NotifyIcon vive en WinForms. Es la unica forma sin dependencias externas de tener icono de
      bandeja en Windows, y mantiene el proyecto dentro de la regla MIT/monetizable.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TaskManager.Desktop</RootNamespace>
    <AssemblyName>TaskManager</AssemblyName>
    <ApplicationTitle>Task Manager</ApplicationTitle>
    <Version>2026.9.1.13</Version>
    <AssemblyVersion>2026.9.1.13</AssemblyVersion>
    <FileVersion>2026.9.1.13</FileVersion>
    <Product>Task Manager</Product>
    <Company>Socratic</Company>
    <Copyright>Copyright © 2026 Socratic</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!--
      Icono del ejecutable: el mismo tick blanco sobre indigo que dibuja TrayIconHost y que lleva la
      aplicacion de Android (constitucion E.6). Va como fichero .ico y no dibujado en codigo porque
      esto lo lee Windows del propio ejecutable —en el Explorador, en la barra de tareas y en el
      aviso de editor desconocido— antes de que corra ninguna linea nuestra.
    -->
    <ApplicationIcon>appicon.ico</ApplicationIcon>

    <!--
      Las DLL nativas van DENTRO del ejecutable.

      Sin esto, `PublishSingleFile` empaqueta solo lo administrado y deja al lado seis ficheros
      nativos (wpfgfx_cor3, PresentationNative_cor3, D3DCompiler_47_cor3, PenImc_cor3,
      vcruntime140_cor3 y e_sqlite3). El .exe parece autocontenido —pesa 170 MB— pero al copiarlo
      solo a otra carpeta arranca y se muere con `DllNotFoundException` dentro de WindowsBase, sin
      ventana ni aviso: parece que no hace nada. Y la entrega es exactamente eso, copiar el .exe a
      una carpeta compartida.

      El coste es que la primera ejecucion extrae esos nativos a una carpeta temporal.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!--
      UseWindowsForms mete System.Windows.Forms en los usings implicitos y choca con WPF en
      Application, Point, Color, Rectangle y KeyEventArgs, y System.Drawing con Color y Rectangle.
      Se quitan los dos: lo unico que se usa de
      WinForms es NotifyIcon (con alias) y System.Drawing solo lo importa TrayIconHost.
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- DPAPI para cifrar los tokens de sesion con la cuenta de Windows del usuario. -->
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskManager.Core\TaskManager.Core.csproj" />
  </ItemGroup>

</Project>
