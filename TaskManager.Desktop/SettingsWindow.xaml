<Window x:Class="TaskManager.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TaskManager.Desktop.Localization"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="{loc:T SettingsTitle}"
        Width="440" SizeToContent="Height"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBackground}">

    <StackPanel Margin="20">
        <StackPanel.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Margin" Value="0,10,0,4" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Margin" Value="0,12,0,0" />
            </Style>
        </StackPanel.Resources>

        <TextBlock Text="{loc:T YourAccount}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />

        <!-- La foto de la cuenta al lado del nombre y el correo. Si no hay, la elipse no se
             enseña y el texto ocupa la fila entera. -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0" x:Name="AvatarCircle" Width="36" Height="36"
                     Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock Grid.Column="1" x:Name="AccountLabel" VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </Grid>
        <!-- Un boton por cuenta: pulsar uno entra con ese proveedor, se estuviera dentro con el
             otro o con ninguno. Cada cuenta tiene sus listas, asi que esto es lo que hace de
             interruptor entre una y otra. -->
        <StackPanel Orientation="Horizontal">
            <Button x:Name="GoogleButton" Style="{StaticResource IconButton}"
                    Content="&#xE77B;" ToolTip="{loc:T SignInGoogle}" Margin="0,0,8,0"
                    Click="OnGoogleClick" />
            <Button x:Name="MicrosoftButton" Style="{StaticResource IconButton}"
                    Content="&#xE902;" ToolTip="{loc:T SignInMicrosoft}" Margin="0,0,8,0"
                    Click="OnMicrosoftClick" />
            <Button x:Name="SignOutButton" Style="{StaticResource GhostIconButton}"
                    Content="&#xE7E8;" ToolTip="{loc:T SignOut}" Click="OnSignOutClick" />
        </StackPanel>

        <TextBlock x:Name="AccountHintLabel" Text="{loc:T AccountListsHint}"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />

        <!-- El nombre lo pone la cuenta con la que se entro (AuthOptions): se enseña, no se edita. -->
        <TextBlock Text="{loc:T DisplayNameLabel}" />
        <TextBox x:Name="DisplayNameBox" IsReadOnly="True" IsTabStop="False"
                 Background="Transparent" BorderThickness="0"
                 Foreground="{DynamicResource TextSecondary}" />

        <TextBlock Text="{loc:T ShortcutLabel}" />
        <TextBox x:Name="HotkeyBox" />

        <TextBlock Text="{loc:T LanguageTitle}" />
        <hc:ComboBox x:Name="LanguageBox" />

        <!-- Aviso de tareas pendientes: encenderlo y cada cuanto insistir. -->
        <CheckBox Style="{StaticResource CheckBoxBaseStyle}" x:Name="NotifyBox" Content="{loc:T RemindPending}" Click="OnNotifyToggled" />

        <TextBlock Text="{loc:T SnoozeLabel}" />
        <hc:ComboBox x:Name="SnoozeBox" />

        <CheckBox Style="{StaticResource CheckBoxBaseStyle}" x:Name="AutoStartBox" Content="{loc:T AutoStartLabel}" />
        <CheckBox Style="{StaticResource CheckBoxBaseStyle}" x:Name="SoundBox" Content="{loc:T SoundOnComplete}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource GhostIconButton}"
                    Content="&#xE711;" ToolTip="{loc:T Cancel}" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button x:Name="SaveButton" Style="{StaticResource IconButton}"
                    Content="&#xE73E;" ToolTip="{loc:T Save}" Click="OnSaveClick" />
        </StackPanel>

        <TextBlock x:Name="StatusLabel" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
    </StackPanel>
</Window>
