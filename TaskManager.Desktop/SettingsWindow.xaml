<Window x:Class="TaskManager.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TaskManager.Desktop.Localization"
        Title="{loc:T SettingsTitle}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBackground}">

    <StackPanel Margin="20">
        <StackPanel.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Margin" Value="0,10,0,4" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Margin" Value="0,12,0,0" />
            </Style>
        </StackPanel.Resources>

        <TextBlock Text="{loc:T YourAccount}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
        <TextBlock x:Name="AccountLabel" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="SignInButton" Style="{StaticResource IconButton}"
                    Content="&#xE77B;" ToolTip="{loc:T SignInGoogle}" Margin="0,0,8,0" Click="OnSignInClick" />
            <Button x:Name="SignOutButton" Style="{StaticResource GhostIconButton}"
                    Content="&#xE7E8;" ToolTip="{loc:T SignOut}" Click="OnSignOutClick" />
        </StackPanel>

        <TextBlock Text="{loc:T DisplayNameLabel}" />
        <TextBox x:Name="DisplayNameBox" />

        <TextBlock Text="{loc:T ShortcutLabel}" />
        <TextBox x:Name="HotkeyBox" />

        <TextBlock Text="{loc:T LanguageTitle}" />
        <ComboBox x:Name="LanguageBox" />

        <CheckBox x:Name="AutoStartBox" Content="{loc:T AutoStartLabel}" />
        <CheckBox x:Name="SoundBox" Content="{loc:T SoundOnComplete}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource GhostIconButton}"
                    Content="&#xE711;" ToolTip="{loc:T Cancel}" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button x:Name="SaveButton" Style="{StaticResource IconButton}"
                    Content="&#xE73E;" ToolTip="{loc:T Save}" Click="OnSaveClick" />
        </StackPanel>

        <TextBlock x:Name="StatusLabel" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
    </StackPanel>
</Window>
