<Window x:Class="TaskManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TaskManager.Desktop.Localization"
        Title="{loc:T AppName}"
        Width="920" Height="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackground}">

    <!--
        Las mismas dos pantallas que Android y en el mismo orden: «Mis tareas» (todo, con filtro) y
        «Mis listas». El gremio y los grupos ya no estan, y el correo esta oculto.
    -->

    <DockPanel>

        <!-- Franja de marca, como la cabecera del movil. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Primary}" Padding="18,12">
            <TextBlock Text="{loc:T AppName}" FontSize="18" FontWeight="SemiBold" Foreground="White" />
        </Border>

        <TabControl x:Name="Tabs" Margin="12,8,12,12">

            <!-- ============================== Mis tareas ============================== -->
            <TabItem Header="{loc:T MenuMyTasks}">
                <DockPanel Margin="4,12,4,4">

                    <!-- Cuantas hay con el filtro puesto, y el boton de refrescar. -->
                    <Grid DockPanel.Dock="Top" Margin="6,0,6,8" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="FilterLabel" Style="{StaticResource HintText}" />
                            <TextBlock x:Name="SummaryLabel" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="RefreshButton" Style="{StaticResource GhostIconButton}"
                                Content="&#xE72C;" ToolTip="{loc:T RefreshTooltip}"
                                VerticalAlignment="Center" Click="OnRefreshClick" />
                    </Grid>

                    <!-- Captura rapida -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="6,0,6,10">
                        <TextBox Grid.Column="0" x:Name="QuickAddBox" Style="{StaticResource Field}"
                                 Background="{DynamicResource CardBackground}"
                                 KeyDown="OnQuickAddKeyDown" />
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;"
                                Margin="8,0,0,0" ToolTip="{loc:T AddTaskTooltip}" Click="OnQuickAddClick" />
                    </Grid>

                    <!-- Buscador: mira en el titulo, las notas, las etiquetas, los pasos y los
                         adjuntos. Busca al escribir, sin boton de buscar. -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="6,0,6,10">
                        <TextBox Grid.Column="0" x:Name="SearchBox" Style="{StaticResource Field}"
                                 Background="{DynamicResource CardBackground}"
                                 TextChanged="OnSearchChanged" />
                        <Button Grid.Column="1" Style="{StaticResource GhostIconButton}" Content="&#xE711;"
                                Margin="8,0,0,0" ToolTip="{loc:T ClearSearchTooltip}"
                                Click="OnClearSearchClick" />
                    </Grid>

                    <!-- Filtros: las mismas ocho pastillas que en Android, en una fila que se desliza. -->
                    <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" Margin="6,0,6,6">
                        <StackPanel x:Name="FilterBox" Orientation="Horizontal" />
                    </ScrollViewer>

                    <!-- Etiquetas en uso. La fila se esconde si no hay ninguna. -->
                    <ScrollViewer x:Name="TagFilterScroll" DockPanel.Dock="Top"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" Margin="6,0,6,10"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="TagFilterBox" Orientation="Horizontal" />
                    </ScrollViewer>

                    <TextBlock x:Name="NoTasksLabel" DockPanel.Dock="Top" Margin="6,10,6,0"
                               Text="{loc:T NoTasksForFilter}" Style="{StaticResource HintText}"
                               Visibility="Collapsed" />

                    <!-- Barra de seleccion: aparece sola en cuanto hay mas de una tarea marcada
                         (Ctrl+clic o Mayus+clic). Solo iconos, como el resto (anexo B.1). -->
                    <Border x:Name="SelectionBar" DockPanel.Dock="Top" Style="{StaticResource Card}"
                            Margin="6,0,6,8" Padding="10,6" Visibility="Collapsed">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" x:Name="SelectionLabel" VerticalAlignment="Center"
                                       Style="{StaticResource ItemTitle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource RowIconButton}" Content="&#xE73E;"
                                        ToolTip="{loc:T BulkDone}" Click="OnBulkDoneClick" />
                                <Button Style="{StaticResource RowIconButton}" Content="&#xE7A7;"
                                        ToolTip="{loc:T BulkPending}" Click="OnBulkPendingClick" />
                                <Button Style="{StaticResource RowIconButton}" Content="&#xE718;"
                                        ToolTip="{loc:T BulkPinOn}" Click="OnBulkPinOnClick" />
                                <Button Style="{StaticResource RowIconButton}" Content="&#xE77A;"
                                        ToolTip="{loc:T BulkPinOff}" Click="OnBulkPinOffClick" />
                                <Button Style="{StaticResource RowIconButton}" Content="&#xE1CB;"
                                        ToolTip="{loc:T BulkTag}" Click="OnBulkTagClick" />
                                <Button Style="{StaticResource RowIconButton}" Content="&#xE8DE;"
                                        ToolTip="{loc:T BulkMove}" Click="OnBulkMoveClick" />
                                <Button Style="{StaticResource RowIconButton}" Content="&#xE74D;"
                                        Foreground="{DynamicResource Danger}"
                                        ToolTip="{loc:T BulkDelete}" Click="OnBulkDeleteClick" />
                                <Button Style="{StaticResource RowIconButton}" Content="&#xE711;"
                                        ToolTip="{loc:T ClearSelection}" Click="OnClearSelectionClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="AllTasksBox" Style="{StaticResource Rows}" Margin="2,0"
                             SelectionMode="Extended"
                             SelectionChanged="OnTaskSelectionChanged"
                             MouseDoubleClick="OnRowDoubleClick"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="OnTaskDragStart"
                             PreviewMouseMove="OnTaskDragMove"
                             DragOver="OnTaskDragOver"
                             Drop="OnTaskDrop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="4,0,4,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <CheckBox Style="{StaticResource CheckBoxBaseStyle}" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  IsChecked="{Binding IsDone, Mode=OneWay}"
                                                  Tag="{Binding Id}" Click="OnTaskToggled" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Opacity="{Binding Opacity}">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource ItemTitle}"
                                                       TextWrapping="Wrap"
                                                       TextDecorations="{Binding Decoration}" />
                                            <TextBlock Text="{Binding Caption}" Style="{StaticResource ItemSubtitle}"
                                                       Visibility="{Binding CaptionVisibility}" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Style="{StaticResource RowIconButton}"
                                                Content="&#xE70F;" ToolTip="{loc:T OpenTaskTooltip}"
                                                Tag="{Binding Id}" Click="OnOpenTaskClick" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- ============================== Mis listas ============================== -->
            <TabItem Header="{loc:T MenuLists}">
                <Grid Margin="4,12,4,4" ColumnDefinitions="250,*">

                    <DockPanel Grid.Column="0" Margin="4,0,12,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource IconButton}"
                                    Content="&#xE710;"
                                    ToolTip="{loc:T NewListTitle}" Click="OnNewListClick" />
                            <Button x:Name="ListsRefreshButton" Style="{StaticResource GhostIconButton}"
                                    Content="&#xE72C;" Margin="8,0,0,0"
                                    ToolTip="{loc:T RefreshTooltip}" Click="OnRefreshClick" />
                        </StackPanel>
                        <ListBox x:Name="ListsBox" Style="{StaticResource PickRows}"
                                 MouseDoubleClick="OnListDoubleClick"
                                 SelectionChanged="OnListSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" />
                                            <TextBlock Text="{Binding Caption}" FontSize="11" Opacity="0.75" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource RowIconButton}"
                                                    Content="&#xE70F;"
                                                    ToolTip="{loc:T RenameListTitle}"
                                                    Tag="{Binding Id}" Click="OnRenameListClick" />
                                            <Button Style="{StaticResource RowIconButton}"
                                                    Content="&#xE74D;" Foreground="{DynamicResource Danger}"
                                                    ToolTip="{loc:T DeleteListTitle}"
                                                    Tag="{Binding Id}" Click="OnDeleteListClick" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <DockPanel Grid.Column="1" Margin="0,0,4,0">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <TextBox Grid.Column="0" x:Name="NewTaskBox" Style="{StaticResource Field}"
                                     Background="{DynamicResource CardBackground}"
                                     KeyDown="OnNewTaskKeyDown" />
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;"
                                    Margin="8,0,0,0" ToolTip="{loc:T AddTaskTooltip}" Click="OnAddTaskClick" />
                        </Grid>

                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <TextBox Grid.Column="0" x:Name="ListSearchBox" Style="{StaticResource Field}"
                                     Background="{DynamicResource CardBackground}"
                                     TextChanged="OnListSearchChanged" />
                            <Button Grid.Column="1" Style="{StaticResource GhostIconButton}" Content="&#xE711;"
                                    Margin="8,0,0,0" ToolTip="{loc:T ClearSearchTooltip}"
                                    Click="OnClearListSearchClick" />
                        </Grid>

                        <!-- Barra de seleccion: aparece sola en cuanto hay mas de una tarea marcada
                             (Ctrl+clic o Mayus+clic). Solo iconos, como el resto (anexo B.1). -->
                        <Border x:Name="ListSelectionBar" DockPanel.Dock="Top" Style="{StaticResource Card}"
                                Margin="0,0,4,8" Padding="10,6" Visibility="Collapsed">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" x:Name="ListSelectionLabel" VerticalAlignment="Center"
                                           Style="{StaticResource ItemTitle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE73E;"
                                            ToolTip="{loc:T BulkDone}" Click="OnBulkDoneClick" />
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE7A7;"
                                            ToolTip="{loc:T BulkPending}" Click="OnBulkPendingClick" />
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE718;"
                                            ToolTip="{loc:T BulkPinOn}" Click="OnBulkPinOnClick" />
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE77A;"
                                            ToolTip="{loc:T BulkPinOff}" Click="OnBulkPinOffClick" />
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE1CB;"
                                            ToolTip="{loc:T BulkTag}" Click="OnBulkTagClick" />
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE8DE;"
                                            ToolTip="{loc:T BulkMove}" Click="OnBulkMoveClick" />
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE74D;"
                                            Foreground="{DynamicResource Danger}"
                                            ToolTip="{loc:T BulkDelete}" Click="OnBulkDeleteClick" />
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE711;"
                                            ToolTip="{loc:T ClearSelection}" Click="OnClearSelectionClick" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListBox x:Name="ListTasksBox" Style="{StaticResource Rows}"
                                 SelectionMode="Extended"
                                 SelectionChanged="OnTaskSelectionChanged"
                                 MouseDoubleClick="OnRowDoubleClick"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="OnTaskDragStart"
                                 PreviewMouseMove="OnTaskDragMove"
                                 DragOver="OnTaskDragOver"
                                 Drop="OnTaskDrop">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,4,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <CheckBox Style="{StaticResource CheckBoxBaseStyle}" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                                      IsChecked="{Binding IsDone, Mode=OneWay}"
                                                      Tag="{Binding Id}" Click="OnTaskToggled" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                        Opacity="{Binding Opacity}">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource ItemTitle}"
                                                           TextWrapping="Wrap"
                                                           TextDecorations="{Binding Decoration}" />
                                                <TextBlock Text="{Binding Caption}" Style="{StaticResource ItemSubtitle}"
                                                           Visibility="{Binding CaptionVisibility}" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Style="{StaticResource RowIconButton}"
                                                    Content="&#xE70F;" ToolTip="{loc:T OpenTaskTooltip}"
                                                    Tag="{Binding Id}" Click="OnOpenTaskClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>


            <!-- ============================== Gremio ============================== -->
            <TabItem Header="{loc:T MenuBoard}">
                <ScrollViewer Margin="4,12,4,4" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="460" HorizontalAlignment="Left" Margin="4">

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="BoardLevel" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource Primary}" />
                                <ProgressBar x:Name="BoardProgress" Height="8" Margin="0,10,0,6"
                                             Maximum="1" Background="{DynamicResource SubmenuBackground}"
                                             Foreground="{DynamicResource Primary}" BorderThickness="0" />
                                <TextBlock x:Name="BoardToNext" Style="{StaticResource HintText}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="BoardXp" Style="{StaticResource ItemTitle}" />
                                <TextBlock x:Name="BoardStreak" Style="{StaticResource ItemTitle}"
                                           Margin="0,8,0,0" />
                                <TextBlock x:Name="BoardNextUnlock" Style="{StaticResource HintText}"
                                           Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
