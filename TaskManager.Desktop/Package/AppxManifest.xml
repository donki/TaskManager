<?xml version="1.0" encoding="utf-8"?>

<!--
    Manifiesto del paquete MSIX para la Microsoft Store.

    LO QUE HAY QUE RELLENAR ANTES DE SUBIR NADA: los tres valores de <Identity> y el
    <PublisherDisplayName> los asigna Partner Center al reservar el nombre de la aplicacion, y
    tienen que coincidir EXACTAMENTE con lo que ponga alli (Product management > Product identity).
    Si no coinciden, la Store rechaza el paquete sin mas explicacion. Estan como
    @@MARCADORES@@ a proposito: un valor inventado que parezca real es peor que un hueco, porque se
    cuela hasta el rechazo.

    El paquete envuelve el ejecutable autocontenido tal cual (no hay instalador): MSIX es
    precisamente lo que la Store pide para una aplicacion de escritorio, y ademas le da instalacion
    y desinstalacion limpias.

    `runFullTrust` es lo que necesita una aplicacion de escritorio de toda la vida dentro de un
    MSIX. Es la unica capacidad que se declara: no hay ninguna otra que pedir (constitucion general,
    seccion 6: minimo privilegio).
-->

<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <Identity
      Name="@@IDENTITY_NAME@@"
      Publisher="@@PUBLISHER@@"
      Version="@@VERSION@@"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Task Manager</DisplayName>
    <PublisherDisplayName>@@PUBLISHER_DISPLAY_NAME@@</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
    <Description>Tareas diarias con listas, etiquetas, pasos y sincronización entre tus dispositivos.</Description>
  </Properties>

  <Dependencies>
    <!-- Windows 10 2004 (19041) en adelante: es el minimo razonable hoy y el que pide la Store. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-ES" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="TaskManager" Executable="TaskManager.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Task Manager"
          Description="Tareas diarias con listas, etiquetas, pasos y sincronización entre tus dispositivos."
          BackgroundColor="transparent"
          Square150x150Logo="Images\Square150x150Logo.png"
          Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile
            Wide310x150Logo="Images\Wide310x150Logo.png"
            Square310x310Logo="Images\Square310x310Logo.png"
            Square71x71Logo="Images\SmallTile.png" />
        <uap:SplashScreen Image="Images\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
