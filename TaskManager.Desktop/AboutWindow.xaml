<Window x:Class="TaskManager.Desktop.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TaskManager.Desktop.Localization"
        Title="{loc:T MenuAbout}"
        Width="560" Height="720"
        MinWidth="460" MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackground}">

    <!--
        «Acerca de», con la MISMA estructura que la de Android (AboutPage): cabecera con logo,
        version y descripcion, contacto, idioma, privacidad y licencia, en ese orden. La pantalla
        Acerca de es homogenea en todas las aplicaciones del catalogo (constitucion de Mobile 7) y
        en Windows sencillamente faltaba: la version solo se veia en el pie del menu del movil.

        El selector de idioma se repite aqui a proposito aunque tambien este en Ajustes: en el resto
        de aplicaciones se cambia el idioma desde esta pantalla, y quien viene del movil lo busca
        aqui.
    -->

    <DockPanel Margin="16">

        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button x:Name="CloseButton" Style="{StaticResource IconButton}"
                    Content="&#xE711;" HorizontalAlignment="Right"
                    ToolTip="{loc:T Close}" Click="OnCloseClick" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">

                <!-- Cabecera -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="24,22">
                    <StackPanel>
                        <Image x:Name="LogoImage" Width="84" Height="84" HorizontalAlignment="Center" />
                        <TextBlock Text="Task Manager" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Primary}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock x:Name="VersionLabel" Style="{StaticResource HintText}"
                                   FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Text="{loc:T AboutDescription}" Style="{StaticResource HintText}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="{loc:T Publisher}" Style="{StaticResource HintText}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Contacto -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:T Contact}" Style="{StaticResource CardTitle}"
                                   Margin="0,0,0,10" />
                        <TextBlock HorizontalAlignment="Center">
                            <Hyperlink NavigateUri="mailto:jsoladelarosa@gmail.com"
                                       RequestNavigate="OnContactClick">
                                <Run Text="{loc:T WriteAuthor}" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{loc:T ContactHint}" Style="{StaticResource HintText}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Idioma -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:T LanguageTitle}" Style="{StaticResource CardTitle}"
                                   Margin="0,0,0,10" />
                        <Grid ColumnDefinitions="*,10,*">
                            <Button Grid.Column="0" x:Name="SpanishButton" Content="Español"
                                    Style="{StaticResource OutlineButton}" Click="OnSpanishClick" />
                            <Button Grid.Column="2" x:Name="EnglishButton" Content="English"
                                    Style="{StaticResource OutlineButton}" Click="OnEnglishClick" />
                        </Grid>
                        <TextBlock Text="{loc:T LanguageHint}" Style="{StaticResource HintText}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Privacidad -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:T Privacy}" Style="{StaticResource CardTitle}"
                                   Foreground="{DynamicResource Success}" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:T PrivacyText}" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Border>

                <!-- Licencia -->
                <Border Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:T License}" Style="{StaticResource CardTitle}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{loc:T LicenseText}" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{loc:T LicenseLine}" Style="{StaticResource HintText}"
                                   FontSize="11" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
