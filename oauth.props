<Project>

  <!--
    Identificadores de OAuth de correo.

    Los valores reales NO viven en el repositorio: GitHub los rechaza (push protection) y la
    constitucion tampoco los admite. Se leen de oauth.local.props (ignorado) o de variables de
    entorno, y de ahi se genera una clase de constantes en obj/.

    Sin valores el fichero se genera igual, con cadenas vacias: la compilacion no se rompe y el
    proveedor sencillamente no se ofrece, que es el comportamiento que ya documenta MailOAuthConfig.
  -->
  <Import Project="$(MSBuildThisFileDirectory)oauth.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)oauth.local.props')" />

  <PropertyGroup>
    <TmMicrosoftClientId Condition="'$(TmMicrosoftClientId)' == ''">$(TM_MS_CLIENT_ID)</TmMicrosoftClientId>
    <TmGoogleAndroidClientId Condition="'$(TmGoogleAndroidClientId)' == ''">$(TM_GOOGLE_ANDROID_ID)</TmGoogleAndroidClientId>
    <TmGoogleDesktopClientId Condition="'$(TmGoogleDesktopClientId)' == ''">$(TM_GOOGLE_DESKTOP_ID)</TmGoogleDesktopClientId>
    <TmGoogleDesktopClientSecret Condition="'$(TmGoogleDesktopClientSecret)' == ''">$(TM_GOOGLE_DESKTOP_SECRET)</TmGoogleDesktopClientSecret>

    <!--
      Esquema de vuelta de Google en Android: el identificador de cliente invertido. Google no
      admite un esquema cualquiera con un cliente de tipo Android (Error 400: invalid_request), y
      el intent-filter que lo recoge necesita el valor en una constante de compilacion, asi que se
      calcula aqui y viaja como una constante mas.
    -->
    <TmGoogleAndroidRedirectScheme>com.googleusercontent.apps.$(TmGoogleAndroidClientId.Replace('.apps.googleusercontent.com', ''))</TmGoogleAndroidRedirectScheme>
  </PropertyGroup>

  <Target Name="GenerateOAuthSecrets" BeforeTargets="BeforeCompile;CoreCompile"
          Inputs="$(MSBuildThisFileFullPath)" Outputs="$(IntermediateOutputPath)OAuthSecrets.g.cs">
    <ItemGroup>
      <TmOAuthLine Include="// Generado por oauth.props. No editar ni subir al repositorio." />
      <TmOAuthLine Include="namespace TaskManager.Core.Services%3B" />
      <!-- Publica: el intent-filter de Android la necesita desde el proyecto del movil. -->
      <TmOAuthLine Include="public static class OAuthSecrets" />
      <TmOAuthLine Include="{" />
      <TmOAuthLine Include="    public const string MicrosoftClientId = &quot;$(TmMicrosoftClientId)&quot;%3B" />
      <TmOAuthLine Include="    public const string GoogleAndroidClientId = &quot;$(TmGoogleAndroidClientId)&quot;%3B" />
      <TmOAuthLine Include="    public const string GoogleDesktopClientId = &quot;$(TmGoogleDesktopClientId)&quot;%3B" />
      <TmOAuthLine Include="    public const string GoogleDesktopClientSecret = &quot;$(TmGoogleDesktopClientSecret)&quot;%3B" />
      <TmOAuthLine Include="    public const string GoogleAndroidRedirectScheme = &quot;$(TmGoogleAndroidRedirectScheme)&quot;%3B" />
      <TmOAuthLine Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)OAuthSecrets.g.cs" Lines="@(TmOAuthLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="IncludeOAuthSecrets" DependsOnTargets="GenerateOAuthSecrets" BeforeTargets="BeforeCompile;CoreCompile">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)OAuthSecrets.g.cs" />
    </ItemGroup>
  </Target>

</Project>
